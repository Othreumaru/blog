---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base>
  <p class="intro">{SITE_DESCRIPTION}</p>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        <a href={`/posts/${p.id}/`}>{p.data.title}</a>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .intro { color: var(--muted); margin: 0 0 2.5rem; }
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li { margin-bottom: 2rem; }
  .posts time {
    display: block;
    color: var(--muted);
    font: 0.8rem ui-sans-serif, system-ui, sans-serif;
  }
  .posts a {
    font: 650 1.2rem/1.3 ui-sans-serif, system-ui, sans-serif;
    text-decoration: none;
  }
  .posts a:hover { text-decoration: underline; }
  .posts p { margin: 0.3rem 0 0; }
</style>
